# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (https://aistudio.google.com/apikey) — free tier, no card required.
# Powers all analysis, chat, and RAG embeddings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — enables real reputation lookups in lib/url/analyzer.ts (unused if unset)
URL_REPUTATION_API_KEY=

# Upstash (https://console.upstash.com) — caches analysis results so an
# identical or near-identical message (viral scam templates get pasted by
# thousands of people) skips the Gemini + rule-engine + RAG pipeline entirely.
# Two databases, both optional (analysis works uncached without them):
#   - Redis: exact-match cache, keyed by a hash of the normalized message text.
#   - Vector: semantic-match cache — create this index with dimension 768 and
#     cosine similarity (it reuses the same Gemini embedding model as the RAG
#     pattern library in lib/ai/embeddings.ts, not Upstash's built-in
#     text-embedding mode).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
# How long a cached analysis stays valid, in seconds. Default: 7 days.
ANALYSIS_CACHE_TTL_SECONDS=604800
# Cosine similarity (0-1) a message needs to reuse another message's cached
# result. Kept high by default — this reuses a specific verdict (risk score,
# named red flags), not just a topic match, so a false "similar enough" hit
# is worse than a cache miss. Default: 0.95.
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.95

# Zernio (https://zernio.com) — connects WhatsApp/Instagram/Facebook/Telegram/SMS
# so the bot can scan incoming messages and reply in-chat. Optional: without
# these, /settings/channels and the webhook route simply error, everything
# else in the app is unaffected.
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_BASE_URL=https://zernio.com/api
# Register this URL as the webhook endpoint in your Zernio dashboard for the
# message.received event: <NEXT_PUBLIC_APP_URL>/api/webhooks/zernio
# NEXT_PUBLIC_APP_URL must be a publicly reachable HTTPS URL for Zernio to
# deliver webhooks and for the OAuth connect callback to work (use a tunnel
# like ngrok for local dev, or your deployed URL).

# Slack (https://api.slack.com/apps) — create an app, add a Bot Token with
# scopes chat:write, im:history, im:read, users:read, set the OAuth Redirect
# URL to <NEXT_PUBLIC_APP_URL>/api/slack/callback, and subscribe to the
# message.im bot event with the Events Request URL set to
# <NEXT_PUBLIC_APP_URL>/api/webhooks/slack (Slack will call it once to verify
# ownership — the app must already be running for that to succeed). Optional:
# without these, /settings/channels' Slack button and the webhook route error.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Discord (https://discord.com/developers/applications) — create an
# application + bot, enable the "Message Content" intent (Bot tab), copy the
# bot token, and generate an OAuth2 URL with the "bot" scope (OAuth2 > URL
# Generator) to use as DISCORD_BOT_INVITE_URL. Discord requires sharing a
# server with a bot before you can DM it, so the invite step is mandatory —
# users are told to do this during the in-app connect flow.
#
# Unlike everything else here, Discord bots only receive DMs over a
# persistent Gateway websocket connection (there's no HTTP webhook for
# ordinary messages), so this needs its own always-on process — it does NOT
# run as part of `next dev`/`next build`/`next start`. Run it separately with:
#   npm run bot:discord
# and keep it running wherever you deploy (a small VPS/Fly.io/Railway box,
# or your own always-on machine) — it can't run on Vercel serverless.
DISCORD_BOT_TOKEN=
DISCORD_BOT_INVITE_URL=
